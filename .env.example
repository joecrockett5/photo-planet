# Copy to .env and fill in. All optional, but set the first two before putting
# this on the internet.

# Shared password for the site. Leave empty for no login (private network only).
APP_PASSWORD=
# Long random string that signs the login cookie, so logins survive restarts.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
# Shown small in the corner and as the browser tab title.
PLANET_TITLE=Photo Planet
# Per-file upload limit in MB.
MAX_UPLOAD_MB=500
# Port on the host machine (docker compose only).
HOST_PORT=8080
