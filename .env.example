# Copy to .env and fill in. All optional.

# Shared password for the site. Leave empty for no login (local use only).
APP_PASSWORD=
# Long random string; keeps people logged in across restarts. e.g. `openssl rand -hex 32`
SESSION_SECRET=
# Shown in the corner of the page and the browser tab.
PLANET_TITLE=Photo Planet
# Per-file upload limit in MB.
MAX_UPLOAD_MB=500
# Port on the host machine (docker compose only).
HOST_PORT=8080
